# ─── Core ─────────────────────────────────────────────
# Production requires JWT_SECRET or the server will exit(1)
NODE_ENV=development
PORT=4000

# ─── Security (required in production) ────────────────
JWT_SECRET=change-me-to-a-long-random-string
SITE_URL=http://localhost:3000

# ─── First-run admin bootstrap ────────────────────────
# Only used when admins table is empty
CREATE_DEFAULT_ADMIN=true
DEFAULT_ADMIN_PASSWORD=choose-a-strong-password

# ─── Data directory (SQLite file lives here) ──────────
# Set to a mounted volume path in production, e.g. /data on Railway volume
DATA_DIR=./data

# ─── SMTP (optional — contact form + newsletter) ──────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=wu27@qfnu.edu.cn

# ─── Public site URL for OG/sitemap generation ────────
PUBLIC_BASE_URL=http://localhost:3000
